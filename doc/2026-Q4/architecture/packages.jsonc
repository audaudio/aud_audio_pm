      ]
    },
    {
      "name": "aud_audio_ui_waveform",
      "template": "flutter",
      "description": "Waveform view of the Audanika Audio Engine, modeled on AudioKit Waveform",
      "platforms": [
        "ios",
        "android",
        "macos",
        "windows",
        "linux",
        "web"
      ],
      "deps": [
        "aud_audio",
        "aud_audio_file"
      ]
    },
    {
      "name": "aud_audio_bench",
      "template": "app",
      "description": "Benchmark app of the Audanika Audio Engine: latency, CPU and xrun numbers per device",
      "platforms": [
        "ios",
        "android"
      ],
      "deps": [
        "aud_audio"
      ]
    },
    {
      "name": "aud_audio_vst3",
      "template": "ffi",
      "description": "VST3 shell of the Audanika Audio Engine over its headless host",
      "platforms": [
        "macos",
        "windows",
        "linux"
      ],
      "deps": [
        "aud_audio_graph"
      ]
    },
    {
      "name": "aud_audio_clap",
      "template": "ffi",
      "description": "CLAP shell of the Audanika Audio Engine over its headless host",
      "platforms": [
        "macos",
        "windows",
        "linux"
      ],
      "deps": [
        "aud_audio_graph"
      ]
    },
    {
      "name": "aud_audio_auv3",
      "template": "ffi",
      "description": "Audio Unit v3 extension of the Audanika Audio Engine over its headless host",
      "platforms": [
        "ios",
        "macos"
      ],
      "deps": [
